+def _artifact_at_commit(root: Path, path: str, commit: str) -> dict[str, Any]:
+    """Read `path` as git stored it at `commit`, never the working tree.
+
+    DEF-05 half (EARNED, DEF-SCP-01): an artifact is evidence for the commit
+    it was produced at, not for whatever the working tree or branch tip
+    happens to hold now.
+    """
+    result = subprocess.run(
+        ["git", "-C", str(root), "cat-file", "-p", f"{commit}:{path}"],
+        capture_output=True, text=True, check=False,
+    )
+    if result.returncode != 0:
+        return {"present_at_commit": False, "detail": result.stderr.strip()}
+    blob = result.stdout.encode("utf-8")
+    return {"present_at_commit": True, "sha256": sha256_bytes(blob)}
+
