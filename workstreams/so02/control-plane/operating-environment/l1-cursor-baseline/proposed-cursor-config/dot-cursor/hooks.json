{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard_write_scope.py",
        "matcher": "git|gh ",
        "timeout": 20
      }
    ],
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/ledger_subagent.py --start",
        "timeout": 20
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/ledger_subagent.py --stop",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/gate_claim_state.py",
        "timeout": 30,
        "loop_limit": 3
      }
    ]
  }
}
