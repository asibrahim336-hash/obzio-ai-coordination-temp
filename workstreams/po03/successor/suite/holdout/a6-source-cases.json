{
  "case_set_id": "po03-a6-hidden-custody-cases-v002",
  "authored_by": "po03-worker-a6",
  "authored_before_producer_read": true,
  "derived_from": [
    "workstreams/po03/COMMISSION.md#Transactional result custody",
    "workstreams/po03/contracts/transactional-result.schema.json",
    "workstreams/po03/tools/validate_contracts.py"
  ],
  "producer_test_hashes_seen_at_authoring": [],
  "cases": [
    {
      "id": "H01-provider-completed-without-commit",
      "attack": "provider_completion_without_result_commit",
      "input_mutation": {
        "provider_state": "COMPLETED",
        "obzio_state": "COMPLETED",
        "result_transaction.result_commit_id": null
      },
      "expected": "reject_or_require_PROVIDER_COMPLETED_UNCOMMITTED",
      "criteria": ["C1", "C2"]
    },
    {
      "id": "H02-noncoordinator-completion",
      "attack": "producer_bypasses_coordinator",
      "input_mutation": {
        "obzio_state": "COMPLETED",
        "completion_actor": "worker"
      },
      "expected": "reject",
      "criteria": ["C2", "C6"]
    },
    {
      "id": "H03-terminal-without-readback",
      "attack": "committed_artifact_has_no_immutable_readback",
      "input_mutation": {
        "obzio_state": "RESULT_COMMITTED",
        "artifacts[0].readback_verified_at": null
      },
      "expected": "reject",
      "criteria": ["C3"]
    },
    {
      "id": "H04-accounting-drift",
      "attack": "manifest_artifact_count_or_bytes_do_not_match",
      "input_mutation": {
        "result_transaction.artifact_count": 2,
        "result_transaction.total_bytes": 999
      },
      "expected": "reject",
      "criteria": ["C3"]
    },
    {
      "id": "H05-duplicate-artifact-id",
      "attack": "two_artifacts_share_identity",
      "input_mutation": {
        "artifacts[1].artifact_id": "art-1"
      },
      "expected": "reject",
      "criteria": ["C3", "C6"]
    },
    {
      "id": "H06-self-acceptance",
      "attack": "producer_accepts_own_result",
      "input_mutation": {
        "independent_acceptance.state": "ACCEPTED",
        "independent_acceptance.reviewer_id": "worker-1",
        "attempt.worker_id": "worker-1"
      },
      "expected": "reject",
      "criteria": ["C2", "C6"]
    },
    {
      "id": "H07-duplicate-callback",
      "attack": "same_callback_replayed",
      "input_mutation": {
        "callback_replay_count": 2,
        "same_idempotency_key": true
      },
      "expected": "one durable result and no duplicate external effect",
      "criteria": ["C5", "C6"]
    },
    {
      "id": "H08-stale-fence-after-transfer",
      "attack": "expired_worker_commits_after_lease_transfer",
      "input_mutation": {
        "old_fence_token": 1,
        "current_fence_token": 2,
        "commit_actor": "old-worker"
      },
      "expected": "reject_stale_commit",
      "criteria": ["C5"]
    },
    {
      "id": "H09-corrupt_readback",
      "attack": "remote_artifact_bytes_differ_from_recorded_hash",
      "input_mutation": {
        "remote_bytes_changed_after_commit": true
      },
      "expected": "reject_or_mark_recovery_required",
      "criteria": ["C3", "C4"]
    },
    {
      "id": "H10-parent-restart",
      "attack": "parent_restarts_after_child_commit_before_ingestion",
      "input_mutation": {
        "child_commit_exists": true,
        "parent_ingestion_record_exists": false,
        "parent_restarted": true
      },
      "expected": "replay_ingestion_without_duplicate_commit",
      "criteria": ["C4", "C5"]
    }
  ]
}
