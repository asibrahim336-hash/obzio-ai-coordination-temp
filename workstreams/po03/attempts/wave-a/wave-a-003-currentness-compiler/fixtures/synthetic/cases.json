    {
      "case_id": "superseded-pointer-exclusion",
      "purpose": "A superseded pointer reachable from the current chain is retained as evidence and excluded from the current source set.",
      "files": {
        "README.md": {
          "text": "# Synthetic estate\n\n## Read in this order\n\n1. `pointer.json`\n"
        },
        "pointer.json": {
          "json": {
            "selected_pointer": {
              "path": "current.json",
              "standing": "CURRENT_ACTIVE"
            },
            "superseded_pointer": {
              "path": "old.json",
              "standing": "SUPERSEDED_V009_UNSENT_RETAINED"
            }
          }
        },
        "current.json": {
          "json": {
            "note": "active launch surface"
          }
        },
        "old.json": {
          "json": {
            "note": "retired pointer retained as evidence"
          }
        }
      },
      "expect": {
        "gate": "PASS",
        "current_includes": [
          "README.md",
          "pointer.json",
          "current.json"
        ],
        "current_excludes": [
          "old.json"
        ],
        "superseded_includes": [
          "old.json"
        ],
        "violations": [],
        "counts": {
          "retained_superseded_evidence": 1,
          "missing_references": 0
        }
      }
    },
