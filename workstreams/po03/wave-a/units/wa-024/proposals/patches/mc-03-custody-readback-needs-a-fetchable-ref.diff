+def _readback_ref_errors(txn: dict[str, Any]) -> list[str]:
+    """A recorded commit id is verifiable only if a fetchable ref accompanies it.
+
+    Producer result commits live on their own branches.  A single-ref checkout,
+    which is what actions/checkout produces, cannot resolve such a commit at any
+    depth, so custody read-back needs the ref as well as the object id.
+    """
+    errors: list[str] = []
+    declared_ref = txn.get("result_commit_ref")
+    locator = txn.get("manifest_uri")
+    match = GIT_LOCATOR_RE.fullmatch(locator) if isinstance(locator, str) else None
+    if match is None:
+        if not _nonempty(declared_ref):
+            errors.append(
+                "$.result_transaction: ingested custody needs a fetchable ref, either "
+                "result_commit_ref or a git:<ref>@<commit>:<path> manifest_uri"
+            )
+        return errors
+    if match.group("commit") != txn["result_commit_id"]:
+        errors.append(
+            "$.result_transaction.manifest_uri: locator commit does not match result_commit_id"
+        )
+    if _nonempty(declared_ref) and declared_ref != match.group("ref"):
+        errors.append(
+            "$.result_transaction.result_commit_ref: disagrees with the manifest_uri locator"
+        )
+    return errors
+
+
+def readback_ref(txn: dict[str, Any]) -> str | None:
+    """Return the ref a verifier must fetch before reading the result commit."""
+    if _nonempty(txn.get("result_commit_ref")):
+        return str(txn["result_commit_ref"]).strip()
+    locator = txn.get("manifest_uri")
+    match = GIT_LOCATOR_RE.fullmatch(locator) if isinstance(locator, str) else None
+    return match.group("ref") if match else None
+
