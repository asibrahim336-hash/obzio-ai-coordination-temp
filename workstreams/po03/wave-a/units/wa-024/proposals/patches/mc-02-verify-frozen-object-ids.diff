+def _git(*args: str) -> tuple[int, str]:
+    completed = subprocess.run(
+        ("git", "-C", str(ROOT), *args),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return completed.returncode, completed.stdout.strip()
+
