+def verify_frozen_object_ids() -> None:
+    """Refuse to freeze provenance that names no object in this repository.
+
+    A forty-character identifier with a wrong tail still resolves through its
+    own abbreviation, so a warm full-history checkout makes it look valid and a
+    lenient ancestry check passes.  Only the exact identifier catches it.
+    """
+    if _git("rev-parse", "--is-shallow-repository")[1] == "true":
+        raise ValueError(
+            "refusing to freeze provenance from a shallow checkout: object "
+            "identifiers are unverifiable here; re-run with full history"
+        )
+    for name, object_id in (
+        ("COMMISSION_COMMIT", COMMISSION_COMMIT),
+        ("PROTOCOL_ANCESTOR", PROTOCOL_ANCESTOR),
+    ):
+        if not FULL_OBJECT_ID_RE.fullmatch(object_id):
+            raise ValueError(f"{name}: must be a full lowercase commit id")
+        if _git("cat-file", "-e", f"{object_id}^{{commit}}")[0] == 0:
+            continue
+        code, resolved = _git("rev-parse", "--verify", "--quiet", f"{object_id[:7]}^{{commit}}")
+        hint = ""
+        if code == 0 and resolved:
+            hint = (
+                f"; its abbreviation {object_id[:7]} resolves to {resolved}, so the "
+                "recorded identifier is prefix-only-correct"
+            )
+        raise ValueError(f"{name} {object_id} names no commit in this repository{hint}")
+
