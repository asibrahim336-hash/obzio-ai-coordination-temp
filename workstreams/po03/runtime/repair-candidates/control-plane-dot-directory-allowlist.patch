+def strip_leading_current_dir(path: str) -> str:
+    """Remove leading "./" segments without eating a leading dot.
+
+    ``str.lstrip("./")`` strips characters, not a prefix, so it also removes the
+    dot from a dot directory: ``.github/workflows/po03-x.yml`` became
+    ``github/workflows/po03-x.yml`` and was judged outside an allowlist that
+    explicitly contains it.
+    """
+    normalised = path.strip()
+    while normalised.startswith("./"):
+        normalised = normalised[2:]
+    return normalised
+
