{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obzio.internal/contracts/wave-compounding-v1.schema.json",
  "title": "Obzio Wave Compounding Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "wave_id",
    "baseline",
    "observations",
    "challenges",
    "external_hypotheses",
    "reproductions",
    "live_mechanism_changes",
    "independent_tests",
    "dispositions",
    "successor_manifest_uri",
    "decision_changed"
  ],
  "properties": {
    "protocol_version": { "const": "OBZIO-WAVE-COMPOUNDING-v1" },
    "wave_id": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "required": ["metrics_uri", "sha256"],
      "properties": {
        "metrics_uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "observations": { "$ref": "#/$defs/nonempty_array" },
    "challenges": { "$ref": "#/$defs/nonempty_array" },
    "external_hypotheses": { "$ref": "#/$defs/nonempty_array" },
    "reproductions": { "$ref": "#/$defs/nonempty_array" },
    "live_mechanism_changes": { "$ref": "#/$defs/nonempty_array" },
    "independent_tests": { "$ref": "#/$defs/nonempty_array" },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject", "decision", "evidence_uri"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["RETAIN", "DELETE", "SUPERSEDE", "RETEST", "REJECT"] },
          "evidence_uri": { "type": "string", "minLength": 1 }
        }
      }
    },
    "successor_manifest_uri": { "type": "string", "minLength": 1 },
    "decision_changed": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty_array": { "type": "array", "minItems": 1 }
  }
}
